# --- Copy this file to .env.local for local dev, and set the same values in Vercel ---

# Linear Personal API key.
# Get it from Linear -> Settings -> Security & access -> Personal API keys -> New key.
# It looks like: lin_api_XXXXXXXXXXXXXXXXXXXXXXXX
LINEAR_API_KEY=lin_api_replace_me

# The Linear team to read the roadmap from (Stratverse Tech).
# You normally do not need to change this.
LINEAR_TEAM_ID=1760cbd0-fb5e-4347-b7fb-ebff5fe2e64e
